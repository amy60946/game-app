* text=auto

# Unity YAML
*.unity    merge=unityyamlmerge eol=lf
*.prefab   merge=unityyamlmerge eol=lf
*.asset    merge=unityyamlmerge eol=lf
*.mat      merge=unityyamlmerge eol=lf
*.anim     merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf
*.meta     eol=lf
*.cs       eol=lf diff=csharp

# Büyük ikili dosyalar Git LFS'te
*.blend filter=lfs diff=lfs merge=lfs -text
# *.fbx: LFS yok — CI her derlemede indirir, ücretsiz LFS bant genişliği yetmez. Oyun modelleri küçük (≤1 MB).
*.fbx   binary
*.glb   filter=lfs diff=lfs merge=lfs -text
*.psd   filter=lfs diff=lfs merge=lfs -text
*.wav   filter=lfs diff=lfs merge=lfs -text
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
# Oyun müziği küçük (<1 MB) ve CI her derlemede indirir: LFS yok (fbx gibi)
Assets/_Pofi/Resources/Audio/*.ogg -filter -diff -merge binary
# Sesli okuma adalı ses rengi örneği (127 KB, build_voice.py okur): LFS yok
art/voice/ref/*.mp3 -filter -diff -merge binary
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.tga   filter=lfs diff=lfs merge=lfs -text
# Not: PNG'ler LFS'te DEĞİL (konsept/önizleme görselleri GitHub'da doğrudan görünsün).
# Oyun yazı tipi küçük (~0,5 MB) ve CI her derlemede indirir: LFS yok
Assets/_Pofi/Resources/Fonts/*.ttf -filter -diff -merge binary
# Kullanıcının Meshy web sitesinden indirip GitHub'a tarayıcıyla yüklediği dosyalar (19 Ekim 2026): web yükleme LFS'e yazamaz
art/meshy/inbox/** -filter -diff -merge binary
