<Project Sdk="Microsoft.NET.Sdk">
  <!-- Yalnız yerel derleme ön kontrolü (run.sh): Pofi.Logic + Pofi.Runtime, NuGet'teki Unity başvuru derlemeleriyle. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0414;CS0649;CS0169;CS0618;CS0067</NoWarn>
    <OutputPath>.out/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_Pofi/Scripts/Logic/**/*.cs" />
    <Compile Include="../../Assets/_Pofi/Scripts/Runtime/**/*.cs" />
    <Compile Include="UrpStubs.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(UnityRef)/unityengine.modules/lib/**/*.dll" Private="false" />
    <Reference Include="$(UnityRef)/unity3d.unityengine.ui/lib/**/*.dll" Private="false" />
    <!-- Packages/manifest.json'da olmayan Unity modülleri: kodda kullanılırsa CI'daki gibi burada da derleme hatası olsun -->
    <Reference Remove="$(UnityRef)/unityengine.modules/lib/**/UnityEngine.ParticleSystemModule.dll" />
    <Reference Remove="$(UnityRef)/unityengine.modules/lib/**/UnityEngine.AIModule.dll" />
    <Reference Remove="$(UnityRef)/unityengine.modules/lib/**/UnityEngine.ClothModule.dll" />
    <Reference Remove="$(UnityRef)/unityengine.modules/lib/**/UnityEngine.TerrainModule.dll" />
    <Reference Remove="$(UnityRef)/unityengine.modules/lib/**/UnityEngine.TerrainPhysicsModule.dll" />
    <Reference Remove="$(UnityRef)/unityengine.modules/lib/**/UnityEngine.VideoModule.dll" />
    <Reference Remove="$(UnityRef)/unityengine.modules/lib/**/UnityEngine.VehiclesModule.dll" />
    <Reference Remove="$(UnityRef)/unityengine.modules/lib/**/UnityEngine.WindModule.dll" />
    <Reference Remove="$(UnityRef)/unityengine.modules/lib/**/UnityEngine.TilemapModule.dll" />
    <Reference Remove="$(UnityRef)/unityengine.modules/lib/**/UnityEngine.VFXModule.dll" />
    <Reference Remove="$(UnityRef)/unityengine.modules/lib/**/UnityEngine.UnityWebRequestAssetBundleModule.dll" />
    <Reference Remove="$(UnityRef)/unityengine.modules/lib/**/UnityEngine.UnityWebRequestWWWModule.dll" />
  </ItemGroup>
</Project>
